{
	"name": "opensidian",
	"description": "Local-first note-taking app with a built-in bash terminal and real-time sync",
	"private": true,
	"version": "7.12.0",
	"type": "module",
	"exports": {
		"./workspace": "./src/lib/workspace/index.ts"
	},
	"scripts": {
		"dev": "bun run dev:local",
		"dev:local": "bun --bun vite dev",
		"dev:remote": "bun --bun vite dev --mode production",
		"build": "bun --bun vite build",
		"deploy": "bun run build && wrangler deploy",
		"preview": "bun --bun vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.1",
		"@epicenter/auth-svelte": "workspace:*",
		"@epicenter/constants": "workspace:*",
		"@epicenter/skills": "workspace:*",
		"@epicenter/svelte": "workspace:*",
		"@tanstack/ai": "catalog:",
		"@tanstack/ai-anthropic": "catalog:",
		"@tanstack/ai-client": "^0.7.2",
		"@tanstack/ai-gemini": "catalog:",
		"@tanstack/ai-grok": "catalog:",
		"@tanstack/ai-openai": "catalog:",
		"@tanstack/ai-svelte": "^0.6.7",
		"arktype": "catalog:",
		"better-auth": "catalog:",
		"mode-watcher": "^1.1.0",
		"typebox": "catalog:",
		"wellcrafted": "catalog:"
	},
	"devDependencies": {
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.0",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.41.0",
		"@epicenter/filesystem": "workspace:*",
		"@epicenter/ui": "workspace:*",
		"@epicenter/workspace": "workspace:*",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "catalog:",
		"@replit/codemirror-vim": "^6.3.0",
		"@sveltejs/adapter-static": "catalog:",
		"@sveltejs/kit": "catalog:",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"bun-types": "catalog:",
		"just-bash": "^2.9.7",
		"shiki": "^3.7.0",
		"svelte": "catalog:",
		"svelte-check": "catalog:",
		"svelte-sonner": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"vite-plugin-node-polyfills": "^0.26.0",
		"y-codemirror.next": "^0.3.5",
		"y-indexeddb": "catalog:",
		"yjs": "catalog:"
	},
	"license": "MIT"
}
